# ── DATABASE ──────────────────────────────────────────────────────────────────
# Local Docker (default):  postgresql://postgres:password@localhost:5432/xps_leads
# Railway:                 auto-provided when you add the Postgres plugin
DATABASE_URL=postgresql://postgres:password@localhost:5432/xps_leads

# ── REDIS ─────────────────────────────────────────────────────────────────────
# Local Docker (default):  redis://localhost:6379
# Railway:                 auto-provided when you add the Redis plugin
REDIS_URL=redis://localhost:6379

# ── LLM — REQUIRED ────────────────────────────────────────────────────────────
# Free key from https://console.groq.com/keys  — click "Create API Key"
# The key starts with: gsk_
# Model used: llama3-8b-8192 (configurable in backend/src/services/groq.ts)
GROQ_API_KEY=your_groq_api_key_here

# ── AUTH — REQUIRED ───────────────────────────────────────────────────────────
# Generate a secure random secret with:  openssl rand -base64 32
JWT_SECRET=your_jwt_secret_here

# ── URLS — REQUIRED ───────────────────────────────────────────────────────────
# FRONTEND_URL: used by the backend for CORS — set to your frontend's public URL
# Local:    http://localhost:3000
# Railway:  https://frontend-xxx.railway.app
FRONTEND_URL=http://localhost:3000

# NEXT_PUBLIC_API_URL: used by the Next.js frontend to call the backend API
# Local:    http://localhost:4000
# Railway:  https://backend-xxx.railway.app
NEXT_PUBLIC_API_URL=http://localhost:4000

# ── RAILWAY — REQUIRED FOR DEPLOYMENT ─────────────────────────────────────────
# Token from: https://railway.app → Account Settings → Tokens → New Token
# Project is pre-wired — RAILWAY_PROJECT_ID must not be changed
RAILWAY_TOKEN=your_railway_token
RAILWAY_PROJECT_ID=0361239a-54f7-4db8-8350-d7931d2b9260

# ── GITHUB — OPTIONAL (GitHub connector) ──────────────────────────────────────
# Create at: https://github.com/settings/developers → OAuth Apps → New OAuth App
# Callback URL: https://<your-backend>/api/connectors/github/callback
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
# GitHub App for XPS Orchestrator: https://github.com/settings/apps → New GitHub App
GITHUB_APP_ID=your_github_app_id
GITHUB_APP_PRIVATE_KEY=your_github_app_private_key_pem_contents

# ── OPENAI — OPTIONAL (GPT Actions connector) ─────────────────────────────────
# Create at: https://platform.openai.com/api-keys — key starts with sk-
OPENAI_API_KEY=your_openai_api_key

# ── GOOGLE — OPTIONAL (Google connector) ──────────────────────────────────────
# Create at: https://console.cloud.google.com → APIs & Services → Credentials
# → Create Credentials → OAuth 2.0 Client ID (Web application)
# Callback URL: https://<your-backend>/api/connectors/google/callback
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ── XPS ORCHESTRATOR — OPTIONAL ───────────────────────────────────────────────
# Set to the deployed URL and API key of your XPS Orchestrator GitHub App
XPS_ORCHESTRATOR_URL=https://your-orchestrator.example.com
XPS_ORCHESTRATOR_API_KEY=your_xps_orchestrator_api_key

# ── SERVER ────────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development


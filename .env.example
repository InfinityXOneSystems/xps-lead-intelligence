# ── DATABASE ──────────────────────────────────────────────────────────────────
# Local Docker (default):  postgresql://postgres:password@localhost:5432/xps_leads
# Railway:                 auto-provided when you add the Postgres plugin
DATABASE_URL=postgresql://postgres:password@localhost:5432/xps_leads

# ── REDIS ─────────────────────────────────────────────────────────────────────
# Local Docker (default):  redis://localhost:6379
# Railway:                 auto-provided when you add the Redis plugin
REDIS_URL=redis://localhost:6379

# ── LLM — REQUIRED ────────────────────────────────────────────────────────────
# Free key from https://console.groq.com/keys  — click "Create API Key"
# The key starts with: gsk_
# Model used: llama3-8b-8192 (configurable in backend/src/services/groq.ts)
GROQ_API_KEY=your_groq_api_key_here

# ── AUTH — REQUIRED ───────────────────────────────────────────────────────────
# Generate a secure random secret with:  openssl rand -base64 32
JWT_SECRET=your_jwt_secret_here

# ── URLS — REQUIRED ───────────────────────────────────────────────────────────
# FRONTEND_URL: used by the backend for CORS — set to your frontend's public URL
# Local:    http://localhost:3000
# Railway:  https://frontend-xxx.railway.app
FRONTEND_URL=http://localhost:3000

# NEXT_PUBLIC_API_URL: used by the Next.js frontend to call the backend API
# Local:    http://localhost:4000
# Railway:  https://backend-xxx.railway.app
NEXT_PUBLIC_API_URL=http://localhost:4000

# ── RAILWAY — REQUIRED FOR DEPLOYMENT ─────────────────────────────────────────
# Token from: https://railway.app → Account Settings → Tokens → New Token
# Project is pre-wired — RAILWAY_PROJECT_ID must not be changed
RAILWAY_TOKEN=your_railway_token
RAILWAY_PROJECT_ID=0361239a-54f7-4db8-8350-d7931d2b9260

# ── GITHUB — OPTIONAL (GitHub connector) ──────────────────────────────────────
# Create at: https://github.com/settings/developers → OAuth Apps → New OAuth App
# Callback URL: https://<your-backend>/api/connectors/github/callback
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
# GitHub App for XPS Orchestrator: https://github.com/settings/apps → New GitHub App
GITHUB_APP_ID=your_github_app_id
GITHUB_APP_PRIVATE_KEY=your_github_app_private_key_pem_contents

# ── OPENAI — OPTIONAL (GPT Actions connector) ─────────────────────────────────
# Create at: https://platform.openai.com/api-keys — key starts with sk-
OPENAI_API_KEY=your_openai_api_key

# ── GOOGLE — OPTIONAL (Google connector) ──────────────────────────────────────
# Create at: https://console.cloud.google.com → APIs & Services → Credentials
# → Create Credentials → OAuth 2.0 Client ID (Web application)
# Callback URL: https://<your-backend>/api/connectors/google/callback
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ── XPS ORCHESTRATOR — OPTIONAL ───────────────────────────────────────────────
# Set to the deployed URL and API key of your XPS Orchestrator GitHub App
XPS_ORCHESTRATOR_URL=https://your-orchestrator.example.com
XPS_ORCHESTRATOR_API_KEY=your_xps_orchestrator_api_key

# ── DOCKER MCP GATEWAY — OPTIONAL ────────────────────────────────────────────
# Defaults to Unix socket at /var/run/docker.sock (standard Docker Desktop location)
# Override only if Docker is on a remote host
DOCKER_SOCKET_PATH=/var/run/docker.sock
# DOCKER_HOST=tcp://your-remote-host
# DOCKER_PORT=2375

# ── GITHUB WEBHOOK SECRET — OPTIONAL ──────────────────────────────────────────
# Set this in your GitHub App settings → Webhook secret
# Used to verify incoming webhook payloads
GITHUB_WEBHOOK_SECRET=your_github_webhook_secret

# ── SERVER ────────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development


# ── EMAIL — REQUIRED FOR OUTREACH ────────────────────────────────────────────
# Option 1: Gmail OAuth2 (recommended — uses same Google OAuth above)
# After Google OAuth, the refresh token grants Gmail send access
GMAIL_USER=your_gmail@gmail.com
GOOGLE_REFRESH_TOKEN=your_google_refresh_token
EMAIL_FROM_NAME=XPS Lead Intelligence

# Option 2: SMTP fallback (SendGrid, Mailgun, SMTP2Go, etc.)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=apikey
SMTP_PASS=your_sendgrid_api_key

# ── SOCIAL MEDIA — OPTIONAL (Social Media Agent) ─────────────────────────────
# Twitter/X API v2 — https://developer.twitter.com/en/portal
TWITTER_CLIENT_ID=your_twitter_client_id
TWITTER_CLIENT_SECRET=your_twitter_client_secret
TWITTER_ACCESS_TOKEN=your_twitter_bearer_token

# LinkedIn API — https://developer.linkedin.com
LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret

# Instagram Graph API — https://developers.facebook.com/docs/instagram-api
INSTAGRAM_APP_ID=your_instagram_app_id
INSTAGRAM_APP_SECRET=your_instagram_app_secret

# ── BUSINESS CONTEXT — for social media auto-replies ────────────────────────
BUSINESS_CONTEXT=We help businesses find and convert high-quality leads using AI-powered intelligence.

# ── OAUTH — REQUIRED FOR LOGIN BUTTONS ───────────────────────────────────────
# Google OAuth App — https://console.cloud.google.com/apis/credentials → OAuth 2.0 Client IDs
# Add authorized redirect URI: https://your-backend.railway.app/api/auth/google/callback
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret

# GitHub OAuth App — https://github.com/settings/developers → OAuth Apps → New
# Add callback URL: https://your-backend.railway.app/api/auth/github/callback
GITHUB_OAUTH_CLIENT_ID=your_github_oauth_app_client_id
GITHUB_OAUTH_CLIENT_SECRET=your_github_oauth_app_client_secret

# JWT secret for session tokens (generate with: openssl rand -base64 32)
JWT_SECRET=replace-with-a-secure-random-string-at-least-32-chars
SESSION_SECRET=replace-with-another-secure-random-string

# Backend public URL (used for OAuth redirect URIs)
BACKEND_URL=https://your-backend.railway.app
